# -- Database ------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/verdant
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/verdant

# -- Cloudinary ----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -- Paymob -------------------------------------------------------------
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# -- Auth (JWT) ---------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_32_BYTES_HEX
ADMIN_EMAIL=admin@kruiden.local
ADMIN_PASSWORD=CHANGE_ME
# ADMIN_PASSWORD is used only for initial seeding of the admin User (email+password).
# After first seed, auth is via User table (email+bcrypt hash) + JWT cookie.
