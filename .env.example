# ── Database ────────────────────────────────────────────────────────────
# Postgres connection used by Prisma. For local dev, a portable Postgres
# works fine. In production use the pooled connection string for DATABASE_URL
# and the direct (non-pooled) string for DIRECT_URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/verdant
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/verdant

# ── Cloudinary (product image uploads) ──────────────────────────────────
# Leave blank to disable image uploads in the admin (products still work
# with remote/Unsplash URLs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Paymob (Egypt payment gateway — Accept API / Hosted Iframe) ──────────
# Leave ALL of these blank to run Cash on Delivery only. The checkout page
# automatically hides "Pay Online" when Paymob isn't fully configured.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────
# Plain password used to sign in at /admin. Choose something strong.
ADMIN_PASSWORD=CHANGE_ME
